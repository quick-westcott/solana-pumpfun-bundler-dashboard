# The TrenchyTools API every chain call goes through (building/sending transactions, Jito bundles, balances, metadata, live trades, vanity mints).
TRENCHY_API_URL=https://api.trenchy.tools
# Your API key: GET https://api.trenchy.tools/api/create-api-key (free, shown once). Can also be pasted in Settings.
TRENCHY_API_KEY=
# Optional: where wallet backups are written. Default: <home>/Desktop/trenchytools-wallets (or <home>/trenchytools-wallets).
# WALLET_BACKUP_DIR=
# Optional: encrypts the vault (backend/keys/wallets.json). Left empty, a key is generated into backend/keys/.encryption-key.
ENCRYPTION_KEY=
# Default Jito tip per launch bundle, in lamports (5000000 = 0.005 SOL). Can also be set in Settings.
JITO_TIP_LAMPORTS=5000000
# Backend port (the Vite dev server on 5183 proxies /api here).
PORT=3101
